<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Daemon label; matches this file's name and the SMAppService registration. -->
    <key>Label</key>
    <string>com.killswitch.daemon</string>

    <!-- Path to the daemon executable inside the app bundle (for SMAppService). -->
    <key>BundleProgram</key>
    <string>Contents/MacOS/com.killswitch.daemon</string>

    <!-- Start at boot — protection from the first second (R2). -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart the daemon if it crashes or is killed (AE5). -->
    <key>KeepAlive</key>
    <true/>

    <!-- XPC Mach service the app uses to talk to the daemon (U7). -->
    <key>MachServices</key>
    <dict>
        <key>com.killswitch.daemon.xpc</key>
        <true/>
    </dict>

    <!-- Local error log for the daemon. -->
    <key>StandardErrorPath</key>
    <string>/var/log/com.killswitch.daemon.log</string>
</dict>
</plist>
